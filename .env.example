# Copy to .env at the repo root: cp .env.example .env
# This single file is read by `pnpm dev`, `pnpm db:seed` and Prisma. Never commit .env.
# There is no email: wishes show up on the admin's "Thông báo" page.
# On Render the same variables are set in the dashboard (see render.yaml); they win over this file.

# ── Database ──────────────────────────────────────────────────────────────
# Local: the `db` service from docker-compose.yml (host port 5433 so it does not clash with a
# Postgres already on 5432).
DATABASE_URL="postgresql://love:love@localhost:5433/love_vouchers?schema=public"

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
# At least 32 characters or the API refuses to start. Generate: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# true when served over HTTPS (production). Secure cookies are dropped on plain http.
COOKIE_SECURE=false

# ── Admin account ─────────────────────────────────────────────────────────
# Created from these on the API's first boot (only while no admin exists). `pnpm db:seed` also
# updates the existing admin to match them, which is how you reset a forgotten password.
ADMIN_EMAIL="anh@example.com"
ADMIN_PASSWORD="matkhau123"
# How the app names you, e.g. "Minh Tai hay gọi là “Bé”".
ADMIN_NAME="Anh"
